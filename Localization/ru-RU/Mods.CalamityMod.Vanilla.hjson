		'''
	// Shinobi Infiltrator
	MonkAltHead:
		'''
		+2 слота стража
		+20% урона призванных существ
		+20% урона метательным оружием
		'''
	MonkAltShirt0:
		'''
		+20% урона призванных существ
		+20% скорости полета метательным оружием
		'''
	MonkAltShirt1: +5% шанса критического удара метательным оружием
	MonkAltPants:
		'''
		+10% урона призванных существ
		+10% шанса критического удара метательным оружием
		'''
	/*
	Accessories
	*/
	SunMoonStones: шансу критического удара, регенерации жизни,
	CelestialStoneShell: Дарует малое увеличение к урону,
	PowerBerserkerGlove: +10% скорости атаки в ближнем бою, не складывается с более слабыми версяими
	MechanicalGlove:
		'''
		+12% урона в ближнем бою
		+12% скорости атаки в ближнем бою, не складывается с более слабыми версяими
		'''
	FireGauntlet1: Увеличивает отбрасывание в ближнем бою, а атаки накладывают Адское Пламя
	FireGauntlet2:
		'''
		+14% урона в ближнем бою
		+14% скорости атаки в ближнем бою, не складывается с более слабыми версяими
		'''
	MoltenQuiver: Деревянные стрелы поджигаются и все стрелы накладывают Адское Пламя
	RifleScope1: Увеличивает дальность обзора для огнестрельного оружия (<right>, чтобы отдалить)
	RifleScope2: Эффект прицела можно отключить видимостью аксессуара
	ReconScope1: +15% урона в дальнем бою
	SniperScope: +12% шанса критического удара в дальнем бою
	Magiluminescence:
		'''
		1.75x ускорения и замедления движения
		1.15x скорости движения, причем этот бонус применяется и к ускорению ботинков
		'''
	FrogLeg: +{0}% скорости прыжка и позвояет совершать авто-прыжок
	// Soaring Insignia
	EmpressFlightBooster1: +33% времени полета крыльев
	EmpressFlightBooster2: +7.5% скорости движения, +10% скорости прыжка, 1.25x ускорения
	GravityGlobe:
		'''
		+32% скорости прыжка и увеличивает скорость падения
		Дарует гравитационный прыжок, который перезаряжается при смене гравитации
		Слегка улучшает скорость движения в воздухе без крыльев
		Нажмите {$Key.UP}, чтобы сменить гравитацию
		Нажмите {$Key.DOWN}, чтобы ускорить падение
		'''
	FlameWakerBoots:
		'''
		+25% урона от эффектов огня
		Все атаки зажигают противников
		'Теперь-то ноги точно не проморозишь'
		'''
	/*
	Armor
	*/
	MagicHat: +6% шанса критического удара магией
	Gi: +10% скорости движения и прыжка
	SolarFlarePieces: +1 ОЗ/с регенерации жизни
	/*
	Potions
	*/
	ArcheryPotion: +5% урона стрел и +20% скорости полета стрел
	AleSake:
		'''
		+25% размера оружия в ближнем бою, но -10% скорости атаки
		Считается за алкоголь для эффекта "Алкогольного Отравления"
		{$Common.AlcoholWarning}
		'''
	FlaskofCursedFlames: Атаки в ближнем бою, кнутами или метательным оружием опаляют врагов Проклятым Пламенем
	FlaskofFire: Атаки в ближнем бою, кнутами или метательным оружием поджигают противников
	FlaskofGold: Атаки в ближнем бою, кнутами или метательным оружием выбивают монеты из противников
	FlaskofIchor: Атаки в ближнем бою, кнутами или метательным оружием снижают защиту противника
	FlaskofNanites: Атаки в ближнем бою, кнутами или метательным оружием запутывают противника
	FlaskofParty: Все атаки разбрасывают конфетти
	FlaskofPoison: Атаки в ближнем бою, кнутами или метательным оружием отравляют противника
	FlaskofVenom: Атаки в ближнем бою, кнутами или метательным оружием отравляют противника Кислотным Ядом
	/*
	Others
	*/
	// Aerial Bane
	DD2BetsyBow: Стреляет кучной россыпью из 6 расщепляющихся стрел
	GoldPickaxe: Может копать демонит, багротан, метеорит, морские призмы и кристаллы морской призмы
	MasterExclusive: Режим Мастера или «Месть»
	// Sparkle Slime Balloon
	GelBalloon:
		'''
		Бросьте микстуру из слизи и мерцающих кристаллов
		Противники, облитые слизью, получают больше больше урона от эффектов огня
		'''
	// Ancient Manipulator
	LunarCraftingStation: Используется, чтобы делать вещи из Лунных Фрагментов, Люминита и Астральных Слитков
	AnkhShield: Дарует иммунитет к большинству эффектов, включая Могучий Ветер
}

// Buff Descriptions
BuffDescription: {
	Banner: У вас увеличена защита от и урон против следующих существ:
	BeetleMight: Урон и скорость атаки в ближнем бою увеличены на {0}% и {1}% соответственно
	ChaosState: Телепортация Жезла Раздора не работает
	Rabies: Регенерация жизни уменьшена, провоцируются различные эффекты
	WeaponImbueConfetti: Все атаки взрываются конфетти
	WeaponImbueCursedFlames: Атаки в ближнем бою, кнуты и метательное оружие поджигают противников проклятым пламенем
	WeaponImbueFire: Атаки в ближнем бою, кнуты и метательное оружие поджигают противников огнем
	WeaponImbueGold: Атаки в ближнем бою, кнуты и метательное оружие заставляют противников ронять больше золота
	WeaponImbueIchor: Атаки в ближнем бою, кнуты и метательное оружие уменьшают защиту противников
	WeaponImbueNanites: Атаки в ближнем бою, кнуты и метательное оружие запутывают противников
	WeaponImbuePoison: Атаки в ближнем бою, кнуты и метательное оружие отравляют противников
	WeaponImbueVenom: Атаки в ближнем бою, кнуты и метательное оружие поражают ядом ваших противников
}

HerbTooltips: {
	Daybloom: "[C/FFEB8A:Радостное растение, которое цветет под солнечным светом]"
	Moonglow: "[C/8AFFFF:Лучащееся растение, которое цветет под лунным светом]"
	Waterleaf: "[C/8AFFAF:Упорное растение, которое цветет под дождем]"
	Blinkroot: "[C/FFC28A:Капризное растение, которое цветет непредсказуемо]"
	Shiverthorn: "[C/AADEFA:Холодное растение, которое цветет медленно, но навечно]"
	Deathweed: "[C/A98AFF:Дурное растение, которое цветет под полной или кровавой луной]"
	Fireblossom: "[C/FF8063:Трепещущее растение, которое цветет в часы зари]"
}

SeedTooltips: {
	Daybloom: "[C/FFEB8A:Сеется в Траве]"
	Moonglow: "[C/8AFFFF:Сеется в Джунглевой Траве]"
	Waterleaf: "[C/8AFFAF:Сеется в Песке]"
	Blinkroot: "[C/FFC28A:Сажается в Земле или Грязи]"
	Shiverthorn: "[C/AADEFA:Сеется в Снегу или на Льду]"
	Deathweed: "[C/A98AFF:Захораниваются в Траве Зла или Камне Зла]"
	Fireblossom: "[C/FF8063:Захораниваются в Пепле]"
