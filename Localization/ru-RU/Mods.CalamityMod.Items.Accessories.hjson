}

ChaliceOfTheBloodGod: {
	DisplayName: Чаша Бога Крови
	Tooltip:
		'''
		Максимальное здоровье увеличено на 25%
		+2 ОЗ/c регенерации жизни и -25% времени перезарядки лечащих зелий%
		Получив более 5 урона удар конвертируется в вредный наносящий урон эффект кровотечения
		Этот вид кровотечения не мешает регенерации жизни
