}

TheAmalgam: {
	DisplayName: Амальгама
	Tooltip:
		'''
		Все атаки накладывают разнообразные вредные эффекты
		+200% урона от элементальных эффектов
		Увеличивает длительность эффектов зелий в два раза, причем они остаются активными даже после смерти
		При получении урона запутывает противников и призывает Текущего Ползуна
		Ползун летает над вами, выпуская облака теневого дождя
		Дарует возможность уклониться от атаки
		После уклонения увеличивает призывательный урон и шанс критического удара на 10%
		'У вас ни малейшей идеи о том, как он вообще держится единым целым'
		'''
	HoldShiftTooltip: "{$Common.DodgeInformation}"
}

TheBee: {
	DisplayName: Пчела
	Tooltip:
		'''
		На полном здоровье ваш урон увеличен на долю от уменьшения входящего урона
		Также при полном здоровье нанесенный вам урон уменьшается в два раза
		Если у вас имеются какие-либо энергетические щиты, то они тоже должны быть на полном заряде, чтобы вышеуказанные эффекты работы
