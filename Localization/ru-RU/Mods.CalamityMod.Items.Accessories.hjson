		'''
}

ChaosStone: {
	DisplayName: Камень Хаоса
	Tooltip:
		'''
		Отключает автоматическое потребление зелий маны
		Предметы, которые потребляют ману могут быть использованы даже без нужного количества маны
		Мана может уйти в отрицательные значения, заставляя вас накладывать и претерпевать эффект [cbuff:CalamityMod/ManaBurn]
