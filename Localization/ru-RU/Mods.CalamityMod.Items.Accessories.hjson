// Be warned translators, this thing fucking sucks
StatMeter: {
	DisplayName: Измеритель Характеристик
	FoolsName: Сито для лапши
	Tooltip:
		'''
		Отображает практически все ваши характеристики
		Характеристики атаки и полезные эффекты будут отображаться в зависимости от предмета в руках
		[REV]
		[ITEMS]
		[GENERIC]
		[ABYSS]
		'''
	RevStats:
		'''
		Усиление Урона Буйства: {0}% | Длительность Буйства: {1} секунд
		Усиление Урона Адреналина: {2}% | Усиление УУ Адреналина: {3}%
		'''

	ClassNameOverride: {
		Default: чистый урон
		Generic: бесклассовый урон
		NoSpeed: " (не получает бонусы скорости)"
		SummonMeleeSpeed: " (кнут)"
	}

	DamageStats:
		'''
		Класс: {0}
		Урон: {1}
		Пробитие Защиты: {2}
		'''
	DamageBase: "[{0} базовый] +"
	DamageNormal: "{0}%"
	DamageMult: " x{0}"
	DamageFlat: " {0} фиксированный"
	Crit: " | Шанс критического удара: {0}%"
	AttackSpeed: Скорость Атаки: {0}%
	WhipMeleeInheritance: " [{0}% от ближнего боя]"
	// Class stats
	AmmoStats: Шанс израсходовать боеприпас: {0}%
	ManaStats: Потребление маны: {0}% | Регенерация маны: {1}
	SummonStats: Слотов Призванных Существ: {0} | Слотов Стражей: {1}
	WhipStats: Дальность Кнута: {0}%
	RogueStats:
		'''
		Максимальная Скрытность: {0} | Восстановление Стоя: {1} в сек. | Восстановление в Движении: {2} в сек	.
		Усиление Скорости Полета Метательного Оружия: {3}%
		'''
	// Utility stats
	ToolRange: Бонус к Дальности Действия Инструментов: ({0}, {1})
	MiningSpeed: " | Скорость Копания: {0}%"
	PlacementRange: Бонус к Дальности Размещения: ({0}, {1})
	TileSpeed: " | Скорость Размещения Блоков: {0}%"
	WallSpeed: " | Скорость Размещения Стен: {0}%"
	// Other stats
	GenericStats:
		'''
		Защита: {0} | УУ: {1}% | Регенерация Жизни: {2} ОЗ/с
		Скорость Движения: {3}% | Высота Прыжка: {4}%
		'''
	FlightTime: " | Время Полета Крыльев: {0} секунд"
	MiscStats: Агрессия Противников против Вас: {0} | Удача: {1}%
	AbyssStats:
		'''
		Сила Света в Бездне: {0}
		Потеря Дыхания за Тик: {1} | Скорость Потери Дыхания: {2}
		Потеря Здоровья за Тик без Дыхания: {3}
		Потеря Защиты от Давления: {4}
		'''
	AbyssStatsHidden: Статистика о Бездне отображается только находясь в Бездне
}

